//@version=6
indicator("DCF Fundamentals + Hybrid Execution Algorithm", shorttitle="DCF-Hybrid", overlay=true, precision=2)

// ============================================================================
// DCF FUNDAMENTALS + HYBRID EXECUTION ALGORITHM
// Slow Loop: Quarterly DCF Authorization (Fundamental Gate)
// Fast Loop: Millisecond Clash Flow Execution (Order Flow Gate)
// ============================================================================

// ============================================================================
// INPUT PARAMETERS - DCF VALUATION (SLOW LOOP - QUARTERLY)
// ============================================================================

// Cash Flow Projections (User inputs for quarterly earnings)
cf_year1 = input.float(1000000, title="Year 1 Cash Flow", step=10000)
cf_year2 = input.float(1200000, title="Year 2 Cash Flow", step=10000)
cf_year3 = input.float(1400000, title="Year 3 Cash Flow", step=10000)
cf_year4 = input.float(1600000, title="Year 4 Cash Flow", step=10000)
cf_year5 = input.float(1800000, title="Year 5 Cash Flow", step=10000)

// DCF Parameters
discount_rate_r = input.float(0.10, title="Discount Rate (r)", minval=0.01, maxval=0.5, step=0.01)
perpetual_growth_g = input.float(0.03, title="Perpetual Growth Rate (g)", minval=0.01, maxval=0.10, step=0.01)

// Company Financials
total_debt = input.float(5000000, title="Total Debt", step=10000)
total_cash = input.float(2000000, title="Total Cash", step=10000)
shares_outstanding = input.float(100000, title="Shares Outstanding", step=1000)

// Valuation Discount for Entry
entry_discount = input.float(0.20, title="Entry Discount % (Buy if P < IVPS * (1 - discount))", minval=0.05, maxval=0.50, step=0.05)

// ============================================================================
// INPUT PARAMETERS - ORDER FLOW EXECUTION (FAST LOOP - MILLISECONDS)
// ============================================================================

// Clash Detection Threshold
clash_threshold = input.float(3.0, title="Clash Imbalance Threshold", minval=1.5, maxval=5.0)
stacked_count = input.int(3, title="Stacked Clash Count (k)", minval=2, maxval=5)
min_vol_threshold = input.float(100.0, title="Min Volume (Anti-Dust)", minval=10.0)

// Order Flow Strength
min_delta_strength = input.float(2.0, title="Min Delta Strength Multiplier", minval=1.0, maxval=5.0)

// ============================================================================
// DISPLAY OPTIONS
// ============================================================================

show_dcf_level = input.bool(true, title="Show DCF IVPS Level")
show_auth_gate = input.bool(true, title="Show Authorization Status")
show_trade_signals = input.bool(true, title="Show Trade Signals")
show_candle_color = input.bool(true, title="Highlight Candles on Signal")

// ============================================================================
// CONSTANTS
// ============================================================================

epsilon = 1e-6

// ============================================================================
// PART 1: SLOW LOOP (QUARTERLY) - DCF VALUATION
// Recalculates only when new earnings data is available
// ============================================================================

// Present Value of Year 1-5 Cash Flows
pv_cf1 = cf_year1 / math.pow(1 + discount_rate_r, 1)
pv_cf2 = cf_year2 / math.pow(1 + discount_rate_r, 2)
pv_cf3 = cf_year3 / math.pow(1 + discount_rate_r, 3)
pv_cf4 = cf_year4 / math.pow(1 + discount_rate_r, 4)
pv_cf5 = cf_year5 / math.pow(1 + discount_rate_r, 5)

// Sum of PV for first 5 years
pv_explicit = pv_cf1 + pv_cf2 + pv_cf3 + pv_cf4 + pv_cf5

// Terminal Value using Perpetuity Growth Model
// TV = (CF_n * (1 + g)) / (r - g)
tv_numerator = cf_year5 * (1 + perpetual_growth_g)
tv_denominator = discount_rate_r - perpetual_growth_g
terminal_value = tv_numerator / (tv_denominator + epsilon)

// Present Value of Terminal Value
pv_terminal = terminal_value / math.pow(1 + discount_rate_r, 5)

// Total Enterprise Value (DCF)
enterprise_value = pv_explicit + pv_terminal

// Intrinsic Value Per Share (IVPS)
// IVPS = (DCF - Total Debt + Total Cash) / Shares Outstanding
net_debt = total_debt - total_cash
ivps = (enterprise_value - net_debt) / (shares_outstanding + epsilon)

// ============================================================================
// AUTHORIZATION GATE (AuthFund)
// Returns 1 if price is trading at or below 80% of IVPS
// Acts as a static permissive filter for high-frequency trading
// ============================================================================

auth_threshold = ivps * (1 - entry_discount)
auth_fund_value = close <= auth_threshold ? 1.0 : 0.0

// ============================================================================
// PART 2: FAST LOOP (MILLISECONDS) - ORDER FLOW EXECUTION
// Runs every candle but only executes if AuthFund = 1
// ============================================================================

// ============================================================================
// ORDER FLOW METRICS
// ============================================================================

// Bid/Ask Volume Distribution
range_price = high - low
range_price := range_price == 0 ? close * 0.0001 : range_price

bid_ratio = (close - low) / range_price
bid_vol = volume * bid_ratio
ask_vol = volume * (1 - bid_ratio)

// Diagonal Clash Imbalance (Bullish)
ci_bullish = ask_vol / (bid_vol[1] + epsilon)

// Anti-Dust Filter
dust_filter = ask_vol >= min_vol_threshold
ci_bullish_filtered = dust_filter ? ci_bullish : 0.0

// Stacked Clash Detection (3 consecutive bars)
clash_current = ci_bullish_filtered > clash_threshold ? 1.0 : 0.0
clash_prev1 = ci_bullish_filtered[1] > clash_threshold ? 1.0 : 0.0
clash_prev2 = ci_bullish_filtered[2] > clash_threshold ? 1.0 : 0.0

stacked_clash_sum = clash_current + clash_prev1 + clash_prev2
stacked_clash_buy = stacked_clash_sum == stacked_count ? 1.0 : 0.0

// ============================================================================
// DELTA VOLUME STRENGTH
// ============================================================================

delta_current = ask_vol - bid_vol
avg_volume = ta.sma(volume, 20)
delta_strength = math.abs(delta_current) / (avg_volume + epsilon)

// ============================================================================
// FINAL HYBRID SIGNAL
// SignalBuy = (AuthFund = 1) AND (Stacked_ClashBuy = 1) AND (Delta_Strength > threshold)
// ============================================================================

signal_buy = (auth_fund_value == 1) and (stacked_clash_buy == 1.0) and (delta_strength > min_delta_strength)

// ============================================================================
// BEARISH MIRROR LOGIC
// ============================================================================

ci_bearish = bid_vol / (ask_vol[1] + epsilon)
ci_bearish_filtered = dust_filter ? ci_bearish : 0.0

clash_sell_current = ci_bearish_filtered > clash_threshold ? 1.0 : 0.0
clash_sell_prev1 = ci_bearish_filtered[1] > clash_threshold ? 1.0 : 0.0
clash_sell_prev2 = ci_bearish_filtered[2] > clash_threshold ? 1.0 : 0.0

stacked_clash_sell_sum = clash_sell_current + clash_sell_prev1 + clash_sell_prev2
stacked_clash_sell = stacked_clash_sell_sum == stacked_count ? 1.0 : 0.0

signal_sell = (auth_fund_value == 1) and (stacked_clash_sell == 1.0) and (delta_strength > min_delta_strength)

// ============================================================================
// CANDLE COLORING & VISUALIZATION
// ============================================================================

// Determine candle color based on signals
candle_color = color.new(color.gray, 100)
if show_candle_color
    if signal_buy
        candle_color := color.new(color.lime, 40)
    else if signal_sell
        candle_color := color.new(color.red, 40)
    else if auth_fund_value == 1
        candle_color := color.new(color.blue, 70)

// Apply candle coloring
barcolor(candle_color, title="Signal Candle Color")

// ============================================================================
// PLOT DCF INTRINSIC VALUE LEVEL
// ============================================================================

plot(show_dcf_level ? ivps : na, title="IVPS (Intrinsic Value Per Share)", color=color.new(color.purple, 0), linewidth=2)
plot(show_dcf_level ? auth_threshold : na, title="Authorization Threshold (80% IVPS)", color=color.new(color.orange, 0), linewidth=2, linestyle=line.style_dashed)

// ============================================================================
// PLOT AUTHORIZATION GATE STATUS
// ============================================================================

// Background highlight when AuthFund is active
bgcolor(show_auth_gate and auth_fund_value == 1 ? color.new(color.blue, 85) : na, title="Authorization Active (AuthFund=1)")

// ============================================================================
// PLOT TRADE SIGNALS ON CHART
// ============================================================================

plotshape(show_trade_signals and signal_buy, title="HYBRID BUY Signal", 
          style=shape.labelup, location=location.belowbar, 
          color=color.new(color.lime, 0), textcolor=color.black, 
          text="BUY\nHybrid", size=size.small)

plotshape(show_trade_signals and signal_sell, title="HYBRID SELL Signal", 
          style=shape.labeldown, location=location.abovebar, 
          color=color.new(color.red, 0), textcolor=color.white, 
          text="SELL\nHybrid", size=size.small)

// ============================================================================
// ALERTS
// ============================================================================

if signal_buy
    alert("HYBRID BUY: DCF Authorization + Stacked Clash", alert.freq_once_per_bar)

if signal_sell
    alert("HYBRID SELL: DCF Authorization + Stacked Clash", alert.freq_once_per_bar)

if auth_fund_value == 1
    alert("DCF AUTH: Price below 80% IVPS - High frequency execution enabled", alert.freq_once_per_bar)

// ============================================================================
// INFO TABLE - REAL-TIME DCF & HYBRID STATUS
// ============================================================================

var table hybrid_table = table.new(position.bottom_right, 2, 16, border_color=color.gray, border_width=2)

if barstate.islast
    // DCF Section
    table.cell(hybrid_table, 0, 0, "DCF VALUATION", text_color=color.white, bgcolor=color.navy, text_halign=text.align_center)
    table.cell(hybrid_table, 1, 0, "", text_color=color.white, bgcolor=color.navy)
    
    table.cell(hybrid_table, 0, 1, "Enterprise Value:", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 1, str.tostring(enterprise_value, format.price), text_color=color.yellow)
    
    table.cell(hybrid_table, 0, 2, "Terminal Value:", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 2, str.tostring(terminal_value, format.price), text_color=color.yellow)
    
    table.cell(hybrid_table, 0, 3, "IVPS:", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 3, str.tostring(ivps, format.price), text_color=color.purple, text_size=size.large)
    
    table.cell(hybrid_table, 0, 4, "Auth Threshold (80%):", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 4, str.tostring(auth_threshold, format.price), text_color=color.orange)
    
    table.cell(hybrid_table, 0, 5, "Current Price:", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 5, str.tostring(close, format.price), text_color=color.white)
    
    table.cell(hybrid_table, 0, 6, "AuthFund Status:", text_color=color.white, bgcolor=color.new(color.black, 50))
    auth_status = auth_fund_value == 1 ? "🟢 ACTIVE" : "🔴 INACTIVE"
    table.cell(hybrid_table, 1, 6, auth_status, text_color=auth_fund_value == 1 ? color.lime : color.red, text_size=size.large)
    
    // Order Flow Section
    table.cell(hybrid_table, 0, 7, "ORDER FLOW EXECUTION", text_color=color.white, bgcolor=color.navy, text_halign=text.align_center)
    table.cell(hybrid_table, 1, 7, "", text_color=color.white, bgcolor=color.navy)
    
    table.cell(hybrid_table, 0, 8, "Bid Volume:", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 8, str.tostring(bid_vol, format.volume), text_color=color.blue)
    
    table.cell(hybrid_table, 0, 9, "Ask Volume:", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 9, str.tostring(ask_vol, format.volume), text_color=color.orange)
    
    table.cell(hybrid_table, 0, 10, "CI Bullish:", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 10, str.tostring(ci_bullish_filtered, format.price), text_color=color.green)
    
    table.cell(hybrid_table, 0, 11, "Stacked Clash Buy:", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 11, str.tostring(stacked_clash_buy), text_color=stacked_clash_buy > 0 ? color.lime : color.gray, text_size=size.large)
    
    table.cell(hybrid_table, 0, 12, "Delta Strength:", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 12, str.tostring(delta_strength, format.price), text_color=color.yellow)
    
    table.cell(hybrid_table, 0, 13, "Threshold:", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 13, str.tostring(min_delta_strength, format.price), text_color=color.gray)
    
    // Final Signal
    table.cell(hybrid_table, 0, 14, "HYBRID SIGNAL", text_color=color.white, bgcolor=color.navy, text_halign=text.align_center)
    table.cell(hybrid_table, 1, 14, "", text_color=color.white, bgcolor=color.navy)
    
    signal_text = signal_buy ? "🟢 BUY" : signal_sell ? "🔴 SELL" : "⚪ NEUTRAL"
    signal_col = signal_buy ? color.lime : signal_sell ? color.red : color.gray
    table.cell(hybrid_table, 0, 15, "Signal:", text_color=color.white, bgcolor=color.new(color.black, 50))
    table.cell(hybrid_table, 1, 15, signal_text, text_color=signal_col, text_size=size.large, text_halign=text.align_center)
